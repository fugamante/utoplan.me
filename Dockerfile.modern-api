FROM node:26-bookworm-slim@sha256:4db36457f406501e6f608802e5da617e5fbd0e80b75901b6a09de1ae5a667d32 AS build

WORKDIR /workspace

COPY .node-version ./
COPY scripts ./scripts/
COPY dtoapi/modern/package.json dtoapi/modern/package-lock.json ./dtoapi/modern/
RUN npm --prefix dtoapi/modern ci --ignore-scripts

COPY dtoapi/modern ./dtoapi/modern/
RUN npm --prefix dtoapi/modern run build

FROM node:26-bookworm-slim@sha256:4db36457f406501e6f608802e5da617e5fbd0e80b75901b6a09de1ae5a667d32

WORKDIR /workspace

ENV NODE_ENV=production
ENV PORT=3001

COPY .node-version ./
COPY scripts ./scripts/
COPY dtoapi/modern/package.json dtoapi/modern/package-lock.json ./dtoapi/modern/
RUN npm --prefix dtoapi/modern ci --omit=dev --ignore-scripts

COPY --from=build /workspace/dtoapi/modern/lib ./dtoapi/modern/lib/
COPY data ./data/

EXPOSE 3001

USER node

CMD ["sh", "-c", "node scripts/verify_deployment_config.js --service=api && node dtoapi/modern/lib/server.js"]
