          "strategy": "generated",
          "sourceColumns": []
        },
        {
          "target": "total_indus",
          "strategy": "candidate",
          "sourceColumns": [
            "emp"
          ],
          "notes": "Likely employment count; confirm against legacy UI wording before import."
        },
        {
          "target": "total_anual",
          "strategy": "direct",
          "sourceColumns": [
            "ap"
          ],
          "notes": "Annual payroll in CBP files."
        },
        {
          "target": "cnaic",
          "strategy": "normalized",
          "sourceColumns": [
            "naics"
          ],
          "notes": "Legacy column is integer; importers targeting the current schema must filter to numeric NAICS values. Aggregate placeholders such as ------ and 23---- require a schema migration before they can be preserved."
        },
        {
          "target": "cnaic_name",
          "strategy": "candidate",
          "sourceColumns": [
            "NAICS2012_TTL"
          ],
          "notes": "Available from the Census 2014 CBP API metadata; production import needs a Census API key or cached NAICS title reference."
        },
