FROM node:26-bookworm-slim@sha256:4db36457f406501e6f608802e5da617e5fbd0e80b75901b6a09de1ae5a667d32

WORKDIR /workspace

ENV NODE_ENV=test

COPY .node-version ./
COPY scripts ./scripts/
COPY dtoapi/modern/package.json dtoapi/modern/package-lock.json ./dtoapi/modern/
RUN npm --prefix dtoapi/modern ci
COPY app/package.json app/package-lock.json ./app/
RUN npm --prefix app ci

COPY app ./app/
COPY dtoapi ./dtoapi/
COPY data ./data/
COPY test ./test/
COPY package.json package-lock.json ./

CMD ["npm", "run", "test:proxy:modern"]
