{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "CommonJS",
    "noImplicitAny": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "target": "ES2020"
  },
  "include": [
    "src/**/*.ts"
  ]
}
