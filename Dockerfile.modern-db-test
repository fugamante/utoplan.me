FROM node:24-bookworm-slim

WORKDIR /workspace

ENV NODE_ENV=test

COPY .node-version ./
COPY scripts ./scripts/
COPY dtoapi/modern/package.json dtoapi/modern/package-lock.json ./dtoapi/modern/
RUN npm --prefix dtoapi/modern ci

COPY dtoapi ./dtoapi/
COPY data ./data/

CMD ["npm", "--prefix", "dtoapi/modern", "run", "test:db"]
